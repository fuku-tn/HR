{
  "permissions": {
    "allow": [
      "Bash(node --check .claude/hooks/test-before-commit.js)",
      "Bash(BIE_PRECOMMIT_CMD='node -e \"console.log\\(\\\\\"not ok 1 - demo\\\\\"\\);process.exit\\(1\\)\"' node .claude/hooks/test-before-commit.js)",
      "Bash(node .claude/hooks/test-before-commit.js)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.js\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/test-before-commit.js\"",
            "timeout": 150
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-secrets.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-syntax.js\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
